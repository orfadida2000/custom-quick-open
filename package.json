{
  "name": "custom-quick-open",
  "displayName": "Custom Quick Open",
  "description": "Open VS Code Quick Open with multiple token extraction options that the default Quick Open doesn't support.",
  "version": "1.0.1",
  "publisher": "orfadida",
  "author": {
    "name": "Or Fadida",
    "email": "or@fadida.net"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/orfadida2000/custom-quick-open.git"
  },
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.74.0",
    "node": ">=20.0.0"
  },
  "keywords": [
    "quick open",
    "go to file",
    "ctrl p",
    "path",
    "selection",
    "word under cursor",
    "navigation",
    "keybinding",
    "token",
    "python module"
  ],
  "categories": [
    "Other"
  ],
  "main": "./index.js",
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "customQuickOpen.open",
        "title": "Custom Quick Open: Open from Selection or Token",
        "category": "Custom Quick Open"
      },
      {
        "command": "customQuickOpen.openPythonModule",
        "title": "Custom Quick Open: Open Python Module from Selection or Token",
        "category": "Custom Quick Open"
      }
    ],
    "keybindings": [
      {
        "command": "customQuickOpen.open",
        "key": "ctrl+k ctrl+p",
        "mac": "cmd+k cmd+p",
        "when": "editorTextFocus"
      },
      {
        "command": "customQuickOpen.openPythonModule",
        "key": "ctrl+k ctrl+alt+p",
        "mac": "cmd+k cmd+alt+p",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish",
    "publish:patch": "vsce publish patch",
    "publish:minor": "vsce publish minor",
    "publish:major": "vsce publish major"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
